{
  "version": 2,
  "regions": ["sin1"],
  "builds": [
    {
      "src": "src/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/index.js"
    }
  ],
  "crons": [
    {
      "path": "/jobs/auto-split-savings",
      "schedule": "0 0 1 * *"
    }
  ]
}
